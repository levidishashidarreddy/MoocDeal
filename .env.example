# ===================================================================
# MOOCDEAL — SRM DEALINGS
# Environment Configuration
# ===================================================================

# Supabase Managed Backend
# Found in Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Google Gemini API Configuration (Server-Side Only)
# Get your API key from Google AI Studio: https://aistudio.google.com/
# Accessed strictly by server-side routes (/api/extract-hallticket, /api/ai-match-course)
# Never prefix with VITE_ to prevent bundling into client-side code.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional: Local Server Port (Defaults to 5173)
PORT=5173
